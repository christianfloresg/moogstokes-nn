    "# corner\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "\n",
    "def plot_chi2_corner(fm, contour_levels=[4.72], cmap=\"gray\"):\n",
    "    \"\"\"\n",
    "    Create a corner-like plot of chi-squared from a FittedModel instance.\n",
    "    Marginalizes all other parameters by taking the minimum chi-squared slice.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    fm : FittedModel\n",
    "        The fitted model containing chi2_grid and parameter grids.\n",
    "    contour_levels : list[float], optional\n",
    "        Δχ² levels for 2D contours.\n",
    "    cmap : str, optional\n",
    "        Colormap for 2D chi-squared plots.\n",
    "    \"\"\"\n",
    "    grids = [fm.grid_vals[p] for p in fm.ordered_params]\n",
    "    chi2 = fm.chi2_grid\n",
    "    n = len(fm.ordered_params)\n",
    "\n",
    "    fig, axs = plt.subplots(n, n, figsize=(3*n, 3*n))\n",
    "\n",
    "    chi2_min_global = np.min(chi2)\n",
    "\n",
    "    for i in range(n):\n",
    "        for j in range(n):\n",
    "            ax = axs[i, j]\n",
    "            if i == j:\n",
    "                param = fm.ordered_params[i]\n",
    "\n",
    "                # 1D profile along this parameter\n",
    "                chi2_1d = min_chi2_slice(chi2, keep_axes=[i])\n",
    "\n",
    "                ax.scatter(grids[i], chi2_1d - chi2_min_global, color='black', s=10)\n",
    "\n",
    "                if param in fm.chi2_itp:  # plot the interpolated curve if available\n",
    "                    xvals = fm.chi2_itp[param][0]\n",
    "                    chi2_1d = fm.chi2_itp[param][1]\n",
    "                    ax.plot(xvals, chi2_1d - chi2_min_global, color='gray', alpha=0.5)\n",
    "                else:\n",
    "                    ax.plot(grids[i], chi2_1d - chi2_min_global, color='gray', alpha=0.5)\n",
    "                \n",
    "                ax.set_title(param)\n",
    "                ax.xaxis.tick_top()\n",
    "                ax.set_ylabel(r\"$\\Delta \\chi^2$\")\n",
    "                ax.yaxis.tick_right()\n",
    "                ax.yaxis.set_label_position(\"right\")\n",
    "\n",
    "            elif i > j:\n",
    "                # 2D slice: param i vs param j\n",
    "                slice_2d = min_chi2_slice(chi2, keep_axes=[j, i])\n",
    "                delta_chi2 = slice_2d - chi2_min_global\n",
    "                delta_chi2 = delta_chi2.T\n",
    "\n",
    "                X, Y = np.meshgrid(grids[j], grids[i])\n",
    "                ax.imshow(delta_chi2, \n",
    "                          origin='lower',\n",
    "                          aspect='auto',\n",
    "                          extent=[grids[j][0], grids[j][-1], grids[i][0], grids[i][-1]],\n",
    "                          cmap=cmap)\n",
    "                #cf = ax.contourf(X, Y, delta_chi2, levels=30, cmap=cmap)\n",
    "                c = ax.contour(X, Y, delta_chi2, levels=contour_levels, colors='white', linewidths=1)\n",
    "\n",
    "                if j == 0:\n",
    "                    ax.set_ylabel(fm.ordered_params[i])\n",
    "                else:\n",
    "                    ax.set_yticks([])\n",
    "                if i == n-1:\n",
    "                    ax.set_xlabel(fm.ordered_params[j])\n",
    "                else:\n",
    "                    ax.set_xticks([])\n",
    "            else:\n",
    "                ax.axis(\"off\")\n",
    "                \n",
    "    plt.subplots_adjust(wspace=0, hspace=0)\n",
    "    plt.tight_layout()\n",
    "\n",
    "    return fig, axs"
   ]
